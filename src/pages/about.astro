---
/**
 * ABOUT PAGE
 * Your portrait: see `portrait` in src/data/site.ts.
 * Until it's set, a clearly labelled placeholder is shown.
 */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ServiceArea from '../components/ServiceArea.astro';
import CtaBand from '../components/CtaBand.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

let portrait: ImageMetadata | undefined;
if (site.portrait) {
  const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
  portrait = files[`/src/assets/photos/${site.portrait}`]?.default;
}

const loves = [
  { icon: 'home', text: 'Small local shops with something special inside' },
  { icon: 'people', text: 'Family businesses passed down (and built up) through the generations' },
  { icon: 'hand', text: 'People brave enough to build something from scratch' },
  { icon: 'sparkle', text: 'Community gatherings where the whole town shows up' },
  { icon: 'heart', text: 'The little things that make small towns feel like home' },
];
const values = ['Honesty', 'Affordability', 'Personal attention', 'Keeping things simple'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Meet Chelsey',
    mainEntity: { '@type': 'Person', name: site.owner, worksFor: { '@type': 'Organization', name: site.name } },
  },
];
---

<Base
  title="Meet Chelsey | Small Town Chatter"
  description="Meet Chelsey, the Ottawa Valley web designer and photographer behind Small Town Chatter. 20+ years of experience, small-town roots and honest, personal service."
  schema={schema}
>
  <!-- ─── Hero ─── -->
  <section class="page-hero about-hero" aria-labelledby="page-title">
    <div class="container about-hero__grid">
      <div class="about-hero__text">
        <p class="eyebrow">Meet Chelsey</p>
        <h1 id="page-title">Just a small-town girl who believes <span class="accent">little things can make a big difference.</span></h1>
      </div>

      <figure class="portrait">
        {
          portrait ? (
            <Picture
              src={portrait}
              alt={site.portraitAlt}
              widths={[480, 720, 960, 1280].filter((w) => w <= portrait.width)}
              sizes="(min-width: 900px) 38vw, 90vw"
              formats={['avif', 'webp']}
              loading="eager"
              class="portrait__img"
            />
          ) : (
            <div class="portrait__placeholder" role="img" aria-label="Placeholder: Chelsey’s portrait will go here">
              <Icon name="camera" size={34} />
              <span class="portrait__ph-title">Chelsey’s portrait goes here</span>
              <span class="portrait__ph-note">Development placeholder. Not shown as a real photo.</span>
            </div>
          )
        }
        <figcaption class="portrait__cap">
          <span class="serif-italic">Chelsey</span>, websites &amp; photography
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ─── Story ─── -->
  <section class="section story" aria-labelledby="story-title">
    <div class="container--narrow">
      <h2 id="story-title" class="story__hello">Hi, I’m Chelsey!</h2>
      <div class="story__body">
        <p class="lede">
          I’m a small-town girl at heart, and my love for websites actually started right here in the Ottawa Valley.
        </p>
        <p>
          More than 20 years ago, sitting in a tech class at Renfrew Collegiate Institute (RCI), I coded my very first
          website.
        </p>
        <p class="story__beat">And I’ve been hooked ever since.</p>
        <p>
          What started as a school project turned into a passion that has stuck with me for more than two decades. Along the
          way, photography became another big part of my life.
        </p>
        <p>
          And while websites and photography might seem like two completely different things, I’ve always felt they have
          something special in common.
        </p>
        <p class="story__pull">They’re both about telling stories and helping people be seen.</p>
      </div>
    </div>
  </section>

  <!-- ─── Why STC ─── -->
  <section class="section section--paper" aria-labelledby="why-title">
    <div class="container split">
      <div>
        <p class="eyebrow">Why Small Town Chatter?</p>
        <h2 id="why-title">Because I have a real soft spot for <span class="accent">small-town life.</span></h2>
        <ul class="loves" role="list">
          {
            loves.map((l) => (
              <li>
                <span class="loves__icon">
                  <Icon name={l.icon} size={20} />
                </span>
                {l.text}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="why-copy">
        <p class="lede">
          So many good local businesses are hard to find online, not because they aren’t great, but because building a
          website can feel intimidating, expensive or just plain confusing.
        </p>
        <p class="muted">
          I started Small Town Chatter to change that. I want professional website design to feel approachable and
          affordable for local business owners, explained in plain language by someone who understands how a small business
          actually runs.
        </p>
        <p class="muted">
          And photography? That’s the other half of my heart. I love capturing natural, meaningful moments: the real laughs,
          the quiet glances, the people and details that make a celebration feel like <em>yours</em>.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── Approach ─── -->
  <section class="section" aria-labelledby="approach-title">
    <div class="container split split--reverse">
      <div>
        <p class="eyebrow">My approach</p>
        <h2 id="approach-title">No big-agency attitude. No complicated process. <span class="accent">Just me, doing what I love.</span></h2>
        <p class="muted">
          When you work with Small Town Chatter, you work directly with me. No account managers, no hand-offs, no being
          passed along to someone you’ve never met.
        </p>
        <ul class="values" role="list" aria-label="What I value">{values.map((v) => <li>{v}</li>)}</ul>
        <blockquote class="approach-quote">
          <p>
            I won’t try to sell you a 20-page website when you only need one. And I won’t turn your baby shower into a staged
            photo shoot.
          </p>
        </blockquote>
      </div>
      <Photo name="notebook-and-coffee" ratio="4/5" sizes="(min-width: 900px) 46vw, 92vw" />
    </div>
  </section>

  <!-- ─── Local roots ─── -->
  <section class="section section--sage roots" aria-labelledby="roots-title">
    <div class="container split">
      <Photo name="autumn-river-forest" ratio="5/4" sizes="(min-width: 900px) 46vw, 92vw" />
      <div>
        <p class="eyebrow">Local roots</p>
        <h2 id="roots-title">Proud of <span class="accent">where I come from.</span></h2>
        <p class="lede">
          The Ottawa Valley is home. It’s where I went to school, where I wrote my first lines of code and where I learned
          that people here look out for each other.
        </p>
        <p class="muted">
          I’m proud to work with businesses and families in Renfrew, Calabogie, Arnprior, Pembroke, Petawawa, Barry’s Bay and
          all the communities in between. And if you’re reading this from somewhere else entirely? You’re very welcome here,
          too. Websites travel well, and I’d love to hear from you.
        </p>
        <ul class="towns" aria-label="Communities served">
          {site.towns.map((t) => <li>{t}</li>)}
          <li class="towns__more">+ beyond the Valley</li>
        </ul>
      </div>
    </div>
  </section>

  <CtaBand heading="Enough about me. <span class='accent'>Tell me about you!</span>" button="Let’s Get Chatting" href="/contact/">
    <p>Whether it’s your business or your next big celebration, I’d love to hear what you have in mind.</p>
  </CtaBand>
</Base>

<style>
  .about-hero {
    background: radial-gradient(900px 520px at 0% 0%, var(--blush-soft), transparent 62%), var(--ivory);
  }
  .about-hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .about-hero h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .portrait {
    margin: 0;
    position: relative;
    max-width: 460px;
    width: 100%;
    justify-self: center;
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1.5px solid var(--terracotta);
    border-radius: 200px 200px var(--radius-lg) var(--radius-lg);
    z-index: 0;
  }
  .portrait :global(.portrait__img),
  .portrait__placeholder {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 200px 200px var(--radius-lg) var(--radius-lg);
  }
  .portrait__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    padding: 2rem;
    color: var(--muted);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(217 208 197 / 0.35) 14px 15px),
      var(--paper);
    border: 2px dashed var(--taupe);
  }
  .portrait__ph-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--charcoal);
  }
  .portrait__ph-note {
    font-size: 0.85rem;
    max-width: 22ch;
  }
  .portrait__cap {
    position: relative;
    z-index: 2;
    margin: -1.5rem auto 0;
    width: fit-content;
    background: var(--ivory);
    border: 1px solid var(--taupe);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-size: 0.92rem;
    box-shadow: var(--shadow);
  }
  .portrait__cap .serif-italic {
    font-size: 1.1rem;
  }

  .story__hello {
    font-size: var(--step-4);
    text-align: center;
    margin-bottom: 2rem;
  }
  .story__body {
    max-width: 40rem;
    margin-inline: auto;
    font-size: var(--step-1);
    line-height: 1.7;
  }
  .story__body p {
    margin-bottom: 1.25em;
  }
  .story__beat {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--terra-deep);
  }
  .story__pull {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1.25;
    text-align: center;
    padding-top: 1.5rem;
    margin-top: 2rem !important;
    border-top: 1px solid var(--taupe);
  }

  .loves {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .loves li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-weight: 500;
  }
  .loves__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ivory);
    color: var(--terra-deep);
  }

  .values {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .values li {
    border: 1px solid var(--sage);
    color: var(--sage-deep);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.93rem;
  }
  .approach-quote {
    margin: 0;
    padding: 1.5rem 1.75rem;
    background: var(--blush-soft);
    border-radius: var(--radius);
    position: relative;
  }
  .approach-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .roots .towns li {
    background: var(--ivory);
  }
</style>
