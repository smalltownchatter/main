---
/**
 * HOME PAGE
 * Headings and paragraphs below are plain text — edit them directly.
 * Prices come from src/data/packages.ts; towns/email from src/data/site.ts.
 */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import PricingCard from '../components/PricingCard.astro';
import ServiceArea from '../components/ServiceArea.astro';
import CtaBand from '../components/CtaBand.astro';
import { packages, pkg, money, allInLine } from '../data/packages';

const little = pkg('little-local');

const reasons = [
  { icon: 'home', title: 'Small-town roots', text: "I grew up in the Ottawa Valley. I know how much a good reputation and a familiar face mean around here." },
  { icon: 'sparkle', title: '20+ years of experience', text: 'I coded my first website more than two decades ago, and I’ve been building, learning and taking photos ever since.' },
  { icon: 'tag', title: 'Transparent pricing', text: 'Clear, all-in website packages. If something costs extra, you’ll know before you commit, not after.' },
  { icon: 'chat', title: 'Straightforward communication', text: 'No jargon, no runaround. Just plain answers from the person actually doing the work.' },
  { icon: 'clock', title: 'Quick, efficient delivery', text: 'A simple process that keeps things moving, so your project doesn’t drag on for months.' },
  { icon: 'heart', title: 'Thoughtful personal service', text: 'You’ll work directly with me from our first chat right through to launch day.' },
];
---

<Base
  title="Small Town Chatter | Ottawa Valley Websites & Photography"
  description="Affordable small business websites and candid event photography in the Ottawa Valley, Ontario. One-page websites from $1,000 all-in, tax included."
>
  <!-- ─── Hero ─── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Small Town Chatter</p>
        <h1 id="hero-title">Small towns. <span class="accent">Big stories.</span></h1>
        <p class="hero__sub">Helping small-town businesses get found and special moments get remembered.</p>
        <div class="hero__intro">
          <p>
            Hi, I’m Chelsey! A small-town girl with over 20 years of experience in websites and photography, and a soft
            spot for the people, businesses and celebrations that make our communities special.
          </p>
          <p>
            I create beautiful, affordable websites for small businesses and capture the little moments that make life’s
            celebrations unforgettable.
          </p>
          <p class="hero__promise">No unnecessary complications. No hidden fees. Just good, honest work from someone who gets it.</p>
        </div>
        <div class="btn-row">
          <a class="btn" href="/websites/">I Need a Website <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/photography/">I’m Planning an Event</a>
        </div>
      </div>

      <div class="hero__art">
        <Photo name="ottawa-valley-coffee-storefront" ratio="4/5" eager class="hero__photo-main" sizes="(min-width: 980px) 34vw, 80vw" />
        <Photo name="party-hat-flowers" ratio="1/1" class="hero__photo-small" sizes="(min-width: 980px) 16vw, 40vw" />
        <p class="hero__tag" aria-hidden="true">
          <span>Websites</span><span class="dot"></span><span>Photography</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ─── Introduction ─── -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container">
      <div class="intro__head center">
        <h2 id="intro-title">Good things happen in small towns. <span class="accent">Let’s make sure people see them.</span></h2>
      </div>
      <div class="intro__body">
        <div class="intro__copy">
          <p class="lede">
            It’s the wave from across Main Street. The bakery that knows your order. The contractor whose dad built half the
            houses on your road. The birthday party in the church hall, and the retirement send-off where everyone has a story.
          </p>
          <p>
            Small towns run on familiar faces, family-run businesses and the relationships that hold a community together.
            But these days, even the best-loved local business needs to be easy to find online, and the moments that matter
            most deserve to be remembered.
          </p>
          <p>
            That’s why I started Small Town Chatter: to help local businesses build a professional online presence, and to
            help families and organizations hold on to their meaningful memories.
          </p>
        </div>
        <div class="intro__quotes">
          <blockquote class="pull">
            <Icon name="laptop" size={26} />
            <p>You don’t need to be a big business to deserve a great website.</p>
          </blockquote>
          <blockquote class="pull pull--blush">
            <Icon name="camera" size={26} />
            <p>And you don’t need to host a big, fancy event to deserve beautiful photographs.</p>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"><Icon name="leaf" size={18} /></div>

  <!-- ─── Services ─── -->
  <section class="section services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">What I do</p>
        <h2 id="services-title">Two ways I can help</h2>
      </div>

      <div class="services__grid">
        <article class="service" aria-labelledby="svc-web">
          <Photo name="boutique-owner" ratio="3/2" class="service__photo" sizes="(min-width: 900px) 46vw, 100vw" />
          <div class="service__body">
            <p class="service__kicker"><Icon name="laptop" size={20} /> Websites for Small Businesses</p>
            <h3 id="svc-web">You run the business. I’ll handle the website.</h3>
            <p>
              You’ve already got enough on your plate. I create straightforward, professional websites that help customers
              find you and get in touch, without needing constant updates.
            </p>
            <p>
              Writing the website copy and sourcing licensed stock photography are included, so you don’t have to
              start from a blank page.
            </p>
            <p class="service__price">
              One-page websites start at <strong>{money(little.price)} all-in</strong>, including applicable tax.
            </p>
            <a class="btn" href="/websites/">Explore Website Design <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </article>

        <article class="service" aria-labelledby="svc-photo">
          <Photo name="stone-bridge-autumn-river" ratio="3/2" class="service__photo" sizes="(min-width: 900px) 46vw, 100vw" />
          <div class="service__body">
            <p class="service__kicker"><Icon name="camera" size={20} /> Event Photography</p>
            <h3 id="svc-photo">You enjoy the moment. I’ll capture it.</h3>
            <p>
              You spend so much time planning a celebration that it’s easy to miss the moments themselves. I blend into the
              background and document the little details, the laughter, the family interactions and all the genuine moments
              in between.
            </p>
            <p>So you can actually be there for it.</p>
            <a class="btn" href="/photography/">Explore Event Photography <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ─── Why choose ─── -->
  <section class="section section--paper why" aria-labelledby="why-title">
    <div class="container">
      <div class="why__grid">
        <div class="section-head why__head">
          <p class="eyebrow">Why Small Town Chatter?</p>
          <h2 id="why-title">A little more personal. <span class="accent">A lot less complicated.</span></h2>
          <p>Small-town roots. Professional experience. Honest prices. Personal service.</p>
        </div>
        <ul class="reasons" role="list">
          {
            reasons.map((r) => (
              <li class="reason">
                <span class="reason__icon">
                  <Icon name={r.icon} size={22} />
                </span>
                <h3 class="reason__title">{r.title}</h3>
                <p>{r.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── Pricing preview ─── -->
  <section class="section pricing-preview" aria-labelledby="pricing-title">
    <div class="container">
      <div class="split split--wide-text">
        <div>
          <p class="eyebrow">Website packages</p>
          <h2 id="pricing-title">Clear prices. <span class="accent">No surprises.</span></h2>
          <p class="lede">{allInLine}</p>
          <p class="muted">
            The price you see is the total for building your website. Domain and hosting have their own ongoing costs, and
            I’ll explain exactly what those are before you commit.
          </p>
          <div class="btn-row">
            <a class="btn" href="/websites/#pricing">See Website Packages <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="pricing-preview__cards">
          {packages.map((p) => <PricingCard pkg={p} compact />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Service area ─── -->
  <section class="section--tight" aria-label="Service area">
    <div class="container">
      <ServiceArea>
        <p>
          I’m based in the Ottawa Valley and work with businesses and families throughout Renfrew, Calabogie, Arnprior,
          Pembroke, Petawawa, Barry’s Bay and the communities in between.
        </p>
        <p>
          Website projects can often be done completely remotely, so if you’re outside the Valley, I’d still love to hear
          from you.
        </p>
      </ServiceArea>
    </div>
  </section>


  <CtaBand heading="Have something worth sharing?" button="Let’s Get Chatting" href="/contact/">
    <p>
      Whether it’s a business that deserves to be found or a celebration you want to remember, I’d love to hear about it.
      No pressure, just a friendly chat.
    </p>
  </CtaBand>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3.5rem, 2rem + 5vw, 7rem);
    background:
      radial-gradient(1200px 520px at 100% 0%, var(--blush-soft), transparent 65%),
      var(--ivory);
  }
  .hero__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero__grid {
      grid-template-columns: 1.08fr 0.92fr;
    }
  }
  .hero h1 {
    font-size: clamp(3rem, 1.9rem + 5.2vw, 6rem);
    line-height: 1.02;
    margin-bottom: 0.35em;
  }
  .hero h1 .accent {
    display: inline-block;
  }
  .hero__sub {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.3;
    max-width: 24ch;
    margin-bottom: 1.5rem;
  }
  .hero__intro {
    max-width: 56ch;
    color: var(--muted);
  }
  .hero__intro p {
    margin-bottom: 0.9em;
  }
  .hero__promise {
    color: var(--charcoal);
    font-weight: 600;
  }
  .hero__art {
    position: relative;
    padding: 0 12% 12% 0;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
  }
  .hero__art :global(.hero__photo-main) {
    box-shadow: var(--shadow);
  }
  .hero__art :global(.hero__photo-small) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    border: 6px solid var(--ivory);
    border-radius: 24px;
    box-shadow: var(--shadow);
  }
  .hero__tag {
    position: absolute;
    left: -0.5rem;
    top: 8%;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--ivory);
    border: 1px solid var(--taupe);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: var(--shadow);
  }
  .hero__tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--terracotta);
  }
  @media (min-width: 640px) {
    .hero__tag {
      left: -1.75rem;
    }
  }

  /* Intro */
  .intro__head {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .intro__body {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .intro__body {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 5rem;
      align-items: center;
    }
  }
  .intro__copy p:not(.lede) {
    color: var(--muted);
    max-width: var(--measure);
  }
  .intro__copy .lede {
    margin-bottom: 1.25rem;
  }
  .intro__quotes {
    display: grid;
    gap: 1rem;
  }
  .pull {
    margin: 0;
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius);
    background: var(--sage-tint);
    color: var(--sage-deep);
    display: grid;
    gap: 0.75rem;
  }
  .pull p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--charcoal);
  }
  .pull--blush {
    background: var(--blush-soft);
    color: var(--terra-deep);
  }
  .divider {
    padding-block: 0.5rem;
  }

  /* Services */
  .services__grid {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .service {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--taupe);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .service :global(.service__photo) {
    border-radius: 0;
  }
  .service__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: clamp(1.6rem, 1.2rem + 2vw, 2.75rem);
  }
  .service__body p {
    color: var(--muted);
  }
  .service__body .btn {
    margin-top: auto;
  }
  .service__body p:last-of-type {
    margin-bottom: 1.75rem;
  }
  .service__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terra-deep) !important;
    margin-bottom: 0.9rem;
  }
  .service h3 {
    font-size: var(--step-3);
  }
  .service__price {
    color: var(--charcoal) !important;
    background: var(--paper);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    width: 100%;
  }

  /* Why */
  .why__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .why__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
      align-items: start;
    }
    .why__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  .reasons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--taupe);
    border: 1px solid var(--taupe);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .reasons {
      grid-template-columns: 1fr 1fr;
    }
  }
  .reason {
    background: var(--ivory);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
  }
  .reason__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--blush-soft);
    color: var(--terra-deep);
    margin-bottom: 1rem;
  }
  .reason__title {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .reason p {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  /* Pricing preview */
  .pricing-preview__cards {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 560px) {
    .pricing-preview__cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
