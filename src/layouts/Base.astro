---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/dm-sans/index.css';
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, siteUrl, allowIndexing } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page */
  schema?: object[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, schema = [], noindex = false, ogImage = '/og-image.jpg' } = Astro.props;

const path = Astro.url.pathname;
const canonical = siteUrl ? `${siteUrl}${path}` : null;
const ogImageUrl = siteUrl ? `${siteUrl}${ogImage}` : ogImage;
const robots = noindex || !allowIndexing ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const businessId = siteUrl ? `${siteUrl}/#business` : '#business';
const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': businessId,
  name: site.name,
  description:
    'Affordable website design for small-town businesses and natural, candid event photography in the Ottawa Valley, Ontario.',
  email: site.email,
  ...(siteUrl ? { url: `${siteUrl}/`, image: `${siteUrl}/og-image.jpg`, logo: `${siteUrl}/icon-512.png` } : {}),
  founder: { '@type': 'Person', name: site.owner },
  areaServed: [
    ...site.towns.map((t) => ({ '@type': 'City', name: `${t}, Ontario` })),
    { '@type': 'Place', name: 'Ottawa Valley, Ontario, Canada' },
  ],
  knowsAbout: ['Small business website design', 'Copywriting', 'Event photography', 'Business photography'],
};
const jsonLd = [baseSchema, ...schema];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf7f2" />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Small Town Chatter — websites and photography in the Ottawa Valley" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
