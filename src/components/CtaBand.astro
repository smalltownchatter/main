---
/** Closing call-to-action band used at the bottom of pages. */
interface Props {
  heading: string;
  button: string;
  href: string;
  eyebrow?: string;
}
const { heading, button, href, eyebrow } = Astro.props;
---

<section class="cta section--dark on-dark" aria-labelledby="cta-heading">
  <div class="container--narrow center cta__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id="cta-heading" class="cta__heading" set:html={heading} />
    <div class="cta__text"><slot /></div>
    <div class="btn-row center">
      <a class="btn btn--light" href={href}>{button} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem) clamp(2.5rem, 2rem + 2vw, 4rem);
    overflow: hidden;
  }
  .cta::before,
  .cta::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .cta::before {
    width: 520px;
    height: 520px;
    left: -220px;
    top: -260px;
    border: 1px solid rgb(238 220 213 / 0.14);
  }
  .cta::after {
    width: 380px;
    height: 380px;
    right: -150px;
    bottom: -210px;
    background: radial-gradient(circle, rgb(199 133 112 / 0.18), transparent 70%);
  }
  .cta__inner {
    position: relative;
    z-index: 1;
  }
  .cta__heading {
    font-size: var(--step-4);
    margin-bottom: 1rem;
  }
  .cta__text {
    color: #e4dfd7;
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 40rem;
    margin-inline: auto;
  }
</style>
